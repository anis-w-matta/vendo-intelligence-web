# The existing FastAPI backend - only used for POST /auth/login (the BFF
# has no login route of its own, see docs/audit/04_auth_map.md). Every
# other call goes to VITE_BFF_URL.
VITE_BACKEND_URL=http://127.0.0.1:8000

# The Node Intelligence BFF (vendo-intelligence-web/backend) - never a
# direct Postgres connection.
VITE_BFF_URL=http://127.0.0.1:8200
