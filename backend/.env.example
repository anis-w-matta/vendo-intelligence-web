# The existing FastAPI services this BFF calls - never a direct Postgres
# connection (see docs/audit/01_architecture_map.md).
BACKEND_URL=http://127.0.0.1:8000
CATALOG_URL=http://127.0.0.1:8100

# Only needed if the target services have API_KEY set (see their own
# .env.example) - blank is a no-op, same convention as those services.
BACKEND_API_KEY=
CATALOG_API_KEY=

# Phase 14 (Gemini Intelligence Layer): powers "Explain this insight" and
# the manager briefing (backend/src/lib/geminiClient.ts). Optional - when
# unset, both features degrade gracefully to an "AI unavailable" state;
# the rest of the app is unaffected. Same model the existing Python
# backend already uses for its own Gemini calls (gemini-3.1-flash-lite).
# Get a key from https://aistudio.google.com/apikey.
GEMINI_API_KEY=

PORT=8200
